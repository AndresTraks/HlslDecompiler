<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>

    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="NUnit" Version="4.3.2" />
    <PackageReference Include="NUnit3TestAdapter" Version="5.0.0" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\HlslDecompiler.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- The test corpus: bytecode in. These were listed a file at a time, 1127 of
         them, which drifted - three entries named files that had been removed, and
         every new fixture wanted four more lines. A pattern apiece copies exactly
         what is there.

         The expected outputs - ShaderSources, ShaderAssembly, the DisassemblyOnly
         listings - are not copied: Goldens reads them in the working tree, where
         blessing rewrites them. A copy made by the last build was compared against
         instead, and a golden changed since was reported as a failure. -->
    <None Update="CompiledShaders\**\*.fxc">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <!-- Effects, kept apart because each holds several shaders. -->
    <None Update="CompiledEffects\**\*.fxc">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="EffectSources\**\*.fx">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <!-- Bytecode the disassembler reads and the HLSL writers do not yet. -->
    <None Update="DisassemblyOnly\**\*.fxc">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <!-- Bytecode in a shape an idiom has to be recovered from, kept apart from the
         fixtures because what it decompiles to is not a fixed point: each holds
         one shape fxc produced, and a test that names what has to come back. -->
    <None Update="IdiomShapes\**\*.fxc">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <ItemGroup>
    <Folder Include="ShaderAssembly\vs_3_0\" />
  </ItemGroup>

</Project>
