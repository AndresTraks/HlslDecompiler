<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>

    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="NUnit" Version="4.3.2" />
    <PackageReference Include="NUnit3TestAdapter" Version="5.0.0" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\HlslDecompiler.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- The test corpus: bytecode in, the writers' expected output beside it.
         These were listed a file at a time, 1127 of them, which drifted - three
         entries named ShaderSources files that had been removed, and every new
         fixture wanted four more lines. A pattern apiece copies exactly what is
         there. -->
    <None Update="CompiledShaders\**\*.fxc">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="ShaderAssembly\**\*.asm">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="ShaderSources\**\*.fx">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <ItemGroup>
    <Folder Include="ShaderAssembly\vs_3_0\" />
  </ItemGroup>

</Project>
